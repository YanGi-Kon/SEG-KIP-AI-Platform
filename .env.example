# Runtime
# IMPORTANT: create .env only for first-time local setup. Do not overwrite an existing .env without a backup.
NODE_ENV=development
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
APP_TIME_ZONE=Asia/Tashkent
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Feature flags. Login API requires WORKSPACE_MODE_ENABLED=true.
# Enable it only after DATABASE_URL and a platform Google Service Account are configured.
WORKSPACE_MODE_ENABLED=false
LEGACY_CONFIG_ENABLED=true
AUTH_REQUIRED=false
OUTBOX_WORKER_ENABLED=false
BACKUP_WORKER_ENABLED=false
FINAL_PDF_WORKER_INTERVAL_MS=5000
DB_AUTO_MIGRATE=false

# PostgreSQL
# Use a dedicated dev/staging database for localhost. Do NOT point development at production
# when testing migrations or write flows such as TO monthly periods.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Platform Google Service Account. Final PDF export requires a Google Workspace
# Shared Drive folder where this account is a Content manager. Ordinary My Drive
# folders are intentionally rejected because service accounts have no personal quota.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_BASE64=

# Personal Drive URL and secret are stored per workspace in PostgreSQL. The
# secret is encrypted with WORKSPACE_ENCRYPTION_KEY; only timeout is global.
PERSONAL_DRIVE_APPS_SCRIPT_TIMEOUT_MS=30000

# Legacy single-workspace fallback only. These are deprecated in multi-workspace mode.
GOOGLE_SPREADSHEET_URL=
GOOGLE_SHEETS_ID=
SIGNATURE_DRIVE_FOLDER_ID=

# Authentication and encryption. Use independent random values of at least 32 characters.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret
APPROVAL_JWT_SECRET=replace-with-a-long-random-approval-secret
ADMIN_JWT_SECRET=replace-with-a-long-random-admin-secret
WORKSPACE_ENCRYPTION_KEY=replace-with-a-32-byte-workspace-key
APPROVAL_TOKEN_TTL=7d
SIGNATURE_IMAGE_TOKEN_TTL=365d

# Optional legacy administrator login. New Workspace mode will use user accounts and roles.
ADMIN_PASSWORD=

# Gmail SMTP / Nodemailer. Use a Google App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
